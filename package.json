{
  "name": "vobby",
  "private": true,
  "version": "0.1.0",
  "description": "취미 궤적 기반 AI 숏폼 자동 생성 플랫폼 — 모노레포 루트",
  "workspaces": [
    "packages/*",
    "services/main-api",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace packages/shared-types --workspace packages/ui-tokens",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
