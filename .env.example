# ─── 공통 인프라 (로컬 개발 기본값 — docker-compose.yml과 일치) ───
# 시크릿 값은 절대 이 파일에 쓰지 않는다 — 각자 .env에만 (DESIGN.md §7)
# 로컬 인프라는 Colima Docker의 docker-compose로 구동: `docker-compose up -d`
# 포트: 5433(DB)·6380(Redis) — 5432/6379는 타 프로젝트가 점유 중이라 격리
DATABASE_URL=postgresql://vobby:vobby@localhost:5433/vobby
REDIS_URL=redis://localhost:6380/0

# ─── services/main-api ───
PORT=4000
JWT_SECRET=
JWT_ACCESS_TTL=1h
REFRESH_TTL_DAYS=30
# Google idToken 검증용 (aud 대조). Kakao는 user/me 조회 방식이라 키 불필요
OAUTH_GOOGLE_CLIENT_ID=

# ─── services/ai-pipeline ───
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# ─── Object Storage (S3 호환) ───
S3_ENDPOINT=
S3_BUCKET=vobby-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── 지도 ───
MAPBOX_ACCESS_TOKEN=

# ─── apps/web ───
# 서버 전용 (NEXT_PUBLIC 아님) — SSR이 main-api를 호출
API_BASE_URL=http://localhost:4000

# ─── services/ai-pipeline (렌더러) ───
# 로컬 스토리지 규약 — S3 도입 시 renderer/db.py resolve_media_path만 교체
MEDIA_STORAGE_ROOT=
# 한글 렌더 폰트 (기본: macOS AppleSDGothicNeo)
RENDER_FONT_PATH=
# 지도 타일 소스 (기본: OSM 공개 타일 — Mapbox 전환 시 템플릿만 교체, 캐시: MEDIA_STORAGE_ROOT/tilecache)
TILE_URL_TEMPLATE=
